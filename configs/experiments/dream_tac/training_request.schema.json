{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robotactile-dream-tac-training-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accelerator_contract",
    "dream_tac_commit",
    "donor_experiment",
    "phase",
    "run_name",
    "dream_tac_root",
    "python_executable",
    "materialization_root",
    "output_root",
    "source_manifest_sha256",
    "materialization_receipt_sha256",
    "t5_cache_sha256",
    "base_checkpoint",
    "resume_checkpoint",
    "cuda_devices",
    "nproc_per_node",
    "master_port",
    "max_iter",
    "save_iter",
    "batch_size",
    "num_workers"
  ],
  "properties": {
    "schema_version": {"const": "robotactile-dream-tac-training-request-v1"},
    "accelerator_contract": {"const": "nvidia_cuda_only_v1"},
    "dream_tac_commit": {"const": "14bab51d6862fd07124745c55cd395ea5caa9fd3"},
    "donor_experiment": {"const": "cosmos_predict2_2b_480p_franka_cut_banana_20260321"},
    "phase": {"enum": ["p2_micro", "p3_full"]},
    "run_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,95}$"},
    "dream_tac_root": {"type": "string", "pattern": "^/"},
    "python_executable": {"type": "string", "pattern": "^/"},
    "materialization_root": {"type": "string", "pattern": "^/"},
    "output_root": {"type": "string", "pattern": "^/"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "materialization_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "t5_cache_sha256": {"$ref": "#/$defs/sha256"},
    "base_checkpoint": {"$ref": "#/$defs/bound_file"},
    "resume_checkpoint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/bound_file"}
      ]
    },
    "cuda_devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "nproc_per_node": {"type": "integer", "minimum": 1, "maximum": 8},
    "master_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "max_iter": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "save_iter": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
    "num_workers": {"type": "integer", "minimum": 0, "maximum": 64}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bound_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "p2_micro"}}},
      "then": {"properties": {"max_iter": {"maximum": 1000}}}
    },
    {
      "if": {"properties": {"phase": {"const": "p3_full"}}},
      "then": {"properties": {"max_iter": {"minimum": 1001}}}
    }
  ]
}
