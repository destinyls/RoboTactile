{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/clean_campaign_manifest.schema.json",
  "title": "RoboTactile CleanCampaignManifest",
  "description": "Frozen clean-only campaign request inventory with hash-bound execution identities.",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/manifestV1"},
    {"$ref": "#/$defs/manifestV2"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativeRequestPath": {"type": "string", "pattern": "^requests/.+"},
    "relativeArtifactPath": {"type": "string", "pattern": "^artifacts/.+"},
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "task", "initial_seed", "exogenous_seed", "base_system_id",
        "dataset_sha256", "base_system_manifest_sha256", "checkpoint_sha256",
        "config_sha256", "trial_manifest_sha256", "pair_key", "run_spec_sha256",
        "run_content_sha256", "request_file_sha256", "request_relpath",
        "artifact_relpath", "max_control_cycles", "max_observation_steps",
        "execute_action_steps"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "task": {"type": "string", "minLength": 1},
        "initial_seed": {"type": "integer", "minimum": 0},
        "exogenous_seed": {"type": "integer", "minimum": 0},
        "base_system_id": {"type": "string", "minLength": 1},
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "base_system_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "trial_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "pair_key": {"$ref": "#/$defs/sha256"},
        "run_spec_sha256": {"$ref": "#/$defs/sha256"},
        "run_content_sha256": {"$ref": "#/$defs/sha256"},
        "request_file_sha256": {"$ref": "#/$defs/sha256"},
        "request_relpath": {"$ref": "#/$defs/relativeRequestPath"},
        "artifact_relpath": {"$ref": "#/$defs/relativeArtifactPath"},
        "max_control_cycles": {"type": "integer", "minimum": 1},
        "max_observation_steps": {"type": "integer", "minimum": 1},
        "execute_action_steps": {"type": "integer", "minimum": 1}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_protocol", "exception_handling", "target_valid_trials_per_task",
        "candidate_trials_per_task", "official_eval_seed", "task_seed_start",
        "policy_seed_mode"
      ],
      "properties": {
        "seed_protocol": {
          "enum": ["sha256_signed31_v1", "univtac_consecutive_task_seed_v1"]
        },
        "exception_handling": {
          "enum": [
            "crash_counted_as_failure_v1",
            "replace_exception_until_target_valid_v1"
          ]
        },
        "target_valid_trials_per_task": {"type": "integer", "minimum": 1},
        "candidate_trials_per_task": {"type": "integer", "minimum": 1},
        "official_eval_seed": {"type": "integer", "minimum": 0},
        "task_seed_start": {"type": "integer", "minimum": 0},
        "policy_seed_mode": {
          "enum": ["separate_exogenous_v1", "same_as_task_seed_v1"]
        }
      }
    },
    "manifestBase": {
      "type": "object",
      "required": [
        "campaign_id", "protocol_id", "policy_kind", "task_registry_sha256",
        "master_seed", "seed_derivation", "simulator_seed_role", "policy_seed_role",
        "planned_trial_count", "confidence_level", "bootstrap_resamples",
        "bootstrap_seed", "trials", "semantic_version"
      ],
      "properties": {
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "protocol_id": {"enum": ["diagnostic_v1", "pilot_v1", "paper_v1"]},
        "policy_kind": {"enum": ["act", "n0"]},
        "task_registry_sha256": {"$ref": "#/$defs/sha256"},
        "master_seed": {"type": "integer", "minimum": 0},
        "seed_derivation": {
          "enum": ["sha256_signed31_v1", "univtac_consecutive_task_seed_v1"]
        },
        "simulator_seed_role": {"const": "initial_seed"},
        "policy_seed_role": {"const": "exogenous_seed"},
        "planned_trial_count": {"type": "integer", "minimum": 1},
        "confidence_level": {
          "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1
        },
        "bootstrap_resamples": {"type": "integer", "minimum": 1},
        "bootstrap_seed": {"type": "integer", "minimum": 0},
        "trials": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trial"}
        }
      }
    },
    "manifestV1": {
      "allOf": [
        {"$ref": "#/$defs/manifestBase"},
        {"type": "object", "properties": {"semantic_version": {"const": "1.0"}}}
      ],
      "unevaluatedProperties": false
    },
    "manifestV2": {
      "allOf": [
        {"$ref": "#/$defs/manifestBase"},
        {
          "type": "object",
          "required": ["sampling"],
          "properties": {
            "sampling": {"$ref": "#/$defs/sampling"},
            "semantic_version": {"const": "2.0"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
