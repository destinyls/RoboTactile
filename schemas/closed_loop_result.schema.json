{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/closed_loop_result.schema.json",
  "title": "RoboTactile ClosedLoopTrialResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_manifest_sha256",
    "pair_key",
    "run_spec_sha256",
    "initial_state_sha256",
    "terminal_status",
    "execution_status",
    "score_eligible",
    "score_success",
    "validation_passed",
    "validation_failure_codes",
    "clean_trace_sha256",
    "delivered_trace_sha256",
    "action_trace_sha256",
    "terminal_trace_sha256",
    "observation_count",
    "control_cycle_count",
    "failure_stage",
    "failure_code",
    "semantic_version"
  ],
  "properties": {
    "trial_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "pair_key": {"$ref": "#/$defs/sha256"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "initial_state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "terminal_status": {"enum": ["success", "task_failure", "early_stop", "timeout", "crash", "validator_rejected", "unsupported_contract"]},
    "execution_status": {"type": ["string", "null"], "enum": ["success", "task_failure", "early_stop", "timeout", "crash", "validator_rejected", "unsupported_contract", null]},
    "score_eligible": {"type": "boolean"},
    "score_success": {"type": ["boolean", "null"]},
    "validation_passed": {"type": ["boolean", "null"]},
    "validation_failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "clean_trace_sha256": {"$ref": "#/$defs/sha256"},
    "delivered_trace_sha256": {"$ref": "#/$defs/sha256"},
    "action_trace_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_trace_sha256": {"$ref": "#/$defs/sha256"},
    "observation_count": {"type": "integer", "minimum": 0},
    "control_cycle_count": {"type": "integer", "minimum": 0},
    "failure_stage": {"type": ["string", "null"]},
    "failure_code": {"type": ["string", "null"]},
    "semantic_version": {"const": "1.0"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
