{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/integrations_lock.schema.json",
  "title": "RoboTactile External Integrations Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "schema_version"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_schema",
          "commit_sha",
          "install_script",
          "integration_id",
          "license_spdx",
          "release_ready",
          "repository_url",
          "source_directory",
          "source_inventory_required"
        ],
        "properties": {
          "artifact_schema": {"type": "string", "minLength": 1},
          "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "install_script": {"type": "string", "pattern": "^(integrations|scripts/live_univtac|scripts/ftp1_policy)/[a-z0-9_]+\\.sh$"},
          "integration_id": {"enum": ["act_runtime", "curobo", "dream_tac", "ftp1_policy", "isaaclab", "n0_twam", "n0_vtla", "univtac"]},
          "license_spdx": {"enum": ["Apache-2.0", "BSD-3-Clause", "CC-BY-NC-SA-4.0", "CC-BY-SA-4.0", "LicenseRef-NVIDIA-NonCommercial"]},
          "release_ready": {"type": "boolean"},
          "repository_url": {"type": "string", "pattern": "^https://github\\.com/"},
          "source_directory": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "source_inventory_required": {"const": true}
        }
      }
    },
    "schema_version": {"const": "robotactile-integrations-lock-v2"}
  }
}
