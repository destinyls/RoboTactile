{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/live_univtac_root_receipt.schema.json",
  "title": "RoboTactile LiveArtifactRootReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_sha256", "run_content_sha256", "source_binding_sha256",
    "trial_manifest_sha256", "pair_key", "run_spec_sha256",
    "fault_manifest_sha256", "rest_references_sha256", "result_sha256",
    "terminal_trace_sha256", "action_trace_sha256", "clean_trace_sha256",
    "delivered_trace_sha256", "members", "evidence_level",
    "simulator_qualification_claimed", "semantic_version"
  ],
  "properties": {
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "run_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_binding_sha256": {"$ref": "#/$defs/sha256"},
    "trial_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "pair_key": {"$ref": "#/$defs/sha256"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "fault_manifest_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "rest_references_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_trace_sha256": {"$ref": "#/$defs/sha256"},
    "action_trace_sha256": {"$ref": "#/$defs/sha256"},
    "clean_trace_sha256": {"$ref": "#/$defs/sha256"},
    "delivered_trace_sha256": {"$ref": "#/$defs/sha256"},
    "members": {
      "type": "array", "minItems": 9, "maxItems": 100000,
      "items": {"$ref": "#/$defs/member"}
    },
    "capture_profile": {
      "enum": ["metrics_only_v1", "preview_v1", "paper_full_v1"]
    },
    "evidence_level": {
      "enum": [
        "unqualified_live_univtac_execution_v1",
        "live_univtac_diagnostic_capture_v1"
      ]
    },
    "simulator_qualification_claimed": {"const": false},
    "semantic_version": {"enum": ["1.0", "1.1", "1.2"]}
  },
  "allOf": [
    {
      "if": {"properties": {"semantic_version": {"const": "1.2"}}},
      "then": {
        "required": ["capture_profile"],
        "properties": {
          "capture_profile": {"enum": ["metrics_only_v1", "preview_v1"]},
          "evidence_level": {"const": "live_univtac_diagnostic_capture_v1"}
        }
      },
      "else": {
        "properties": {
          "capture_profile": {"const": "paper_full_v1"},
          "evidence_level": {"const": "unqualified_live_univtac_execution_v1"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}
