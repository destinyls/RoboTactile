{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/matrix_manifest.schema.json",
  "title": "RoboTactile MatrixManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_id", "kind", "pair_key", "cells", "comparisons", "semantic_version"],
  "properties": {
    "matrix_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["primary_14x5_blind", "focused_phase"]},
    "pair_key": {"$ref": "#/$defs/sha256"},
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
    "comparisons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/comparison"}},
    "semantic_version": {"const": "2.0"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator": {"enum": [
      "A1_stream_absence", "A2_frame_erasure", "F1_global_response_drift",
      "F2_spatial_sensitivity_loss", "F3_persistent_surface_artifact",
      "F4_local_nonresponsive_patch", "F5_contact_shape_distortion",
      "F6_history_residual_imprint", "F7_high_load_saturation",
      "T1_fixed_source_delay", "T2_held_last_freeze", "T3_inter_sensor_skew",
      "C1_sensor_identity_misrouting", "C2_frame_misregistration"
    ]},
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["trial", "fault_manifest", "semantic_version"],
      "properties": {
        "trial": {"$ref": "https://robotactile.invalid/schemas/trial_manifest.schema.json"},
        "fault_manifest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "https://robotactile.invalid/schemas/fault_manifest.schema.json"}
          ]
        },
        "semantic_version": {"const": "2.0"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": [
        "point_id", "focus_id", "operator_id", "severity_level", "native_dose",
        "clean_cell_sha256", "faulted_cell_sha256", "no_touch_cell_sha256"
      ],
      "properties": {
        "point_id": {"$ref": "#/$defs/sha256"},
        "focus_id": {"type": "string", "minLength": 1},
        "operator_id": {"$ref": "#/$defs/operator"},
        "severity_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "native_dose": {"type": "number"},
        "clean_cell_sha256": {"$ref": "#/$defs/sha256"},
        "faulted_cell_sha256": {"$ref": "#/$defs/sha256"},
        "no_touch_cell_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
