{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/n0_observation_parity.schema.json",
  "title": "RoboTactile N0-TWAM UniVTAC Observation Parity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_sha256",
    "evidence",
    "evidence_level",
    "failure_codes",
    "gates",
    "limitations",
    "passed",
    "semantic_version",
    "source_binding",
    "task_id"
  ],
  "properties": {
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "evidence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/experimentLockEvidence"},
        {"$ref": "#/$defs/teacherForcedEvidence"},
        {"$ref": "#/$defs/isaacInstallEvidence"},
        {"$ref": "#/$defs/n0ClientInstallEvidence"},
        {"$ref": "#/$defs/n0RuntimeEvidence"},
        {"$ref": "#/$defs/tacexInstallEvidence"},
        {"$ref": "#/$defs/n0ArtifactEvidence"}
      ],
      "items": false
    },
    "evidence_level": {
      "const": "source_bound_n0_univtac_observation_contract_parity_v2"
    },
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "gates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/sourceIdentityGate"},
        {"$ref": "#/$defs/experimentLockGate"},
        {"$ref": "#/$defs/teacherForcedGate"},
        {"$ref": "#/$defs/cameraRendererGate"},
        {"$ref": "#/$defs/modelBoundaryGate"},
        {"$ref": "#/$defs/stateRegistrationGate"}
      ],
      "items": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "passed": {"type": "boolean"},
    "semantic_version": {"const": "2.0"},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "task_id": {"$ref": "#/$defs/taskId"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {
      "type": "string",
      "pattern": "^(artifacts|outputs|requests)/[A-Za-z0-9._/-]+$"
    },
    "taskId": {
      "enum": [
        "grasp_classify",
        "insert_HDMI",
        "insert_hole",
        "insert_tube",
        "lift_bottle",
        "lift_can",
        "pull_out_key",
        "put_bottle_in_shelf"
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_execution_contract",
        "checkpoint_sha256",
        "config_sha256",
        "input_profile_sha256",
        "integrations_lock_sha256",
        "n0_source_commit",
        "native_step_contract",
        "normalizer_sha256",
        "prompt_manifest_sha256",
        "robotactile_source_manifest_sha256",
        "robotactile_wheel_sha256",
        "serve_bundle_sha256",
        "univtac_source_commit"
      ],
      "properties": {
        "action_execution_contract": {"type": "string", "minLength": 1},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "input_profile_sha256": {"$ref": "#/$defs/sha256"},
        "integrations_lock_sha256": {"$ref": "#/$defs/sha256"},
        "n0_source_commit": {"$ref": "#/$defs/commit"},
        "native_step_contract": {"type": "string", "minLength": 1},
        "normalizer_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "robotactile_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "robotactile_wheel_sha256": {"$ref": "#/$defs/sha256"},
        "serve_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "univtac_source_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "kind", "relpath", "sha256"],
      "properties": {
        "content_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "kind": {"type": "string"},
        "relpath": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "experimentLockEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "experiment_lock"}}}
      ]
    },
    "teacherForcedEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "teacher_forced_probe"}}}
      ]
    },
    "isaacInstallEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "isaac_install_receipt"}}}
      ]
    },
    "n0ClientInstallEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "n0_client_install_receipt"}}}
      ]
    },
    "n0RuntimeEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "n0_runtime_receipt"}}}
      ]
    },
    "tacexInstallEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "tacex_install_receipt"}}}
      ]
    },
    "n0ArtifactEvidence": {
      "allOf": [
        {"$ref": "#/$defs/evidence"},
        {"properties": {"kind": {"const": "n0_artifact_manifest"}}}
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "gate_id", "status"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "detail": {"type": "string", "minLength": 1},
        "gate_id": {"type": "string"},
        "status": {"enum": ["pass", "fail", "unknown"]}
      }
    },
    "sourceIdentityGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "source_identity"}}}
      ]
    },
    "experimentLockGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "experiment_lock"}}}
      ]
    },
    "teacherForcedGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "teacher_forced_probe"}}}
      ]
    },
    "cameraRendererGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "camera_renderer"}}}
      ]
    },
    "modelBoundaryGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "model_boundary"}}}
      ]
    },
    "stateRegistrationGate": {
      "allOf": [
        {"$ref": "#/$defs/gate"},
        {"properties": {"gate_id": {"const": "state_registration"}}}
      ]
    }
  }
}
