{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/n0_twam_artifact_manifest.schema.json",
  "title": "Official N0-TWAM UniVTAC Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_mode", "base_repository", "base_revision", "base_root",
    "bundle_root", "checkpoint_path", "checkpoint_repository",
    "checkpoint_revision", "checkpoint_root", "checkpoint_sha256",
    "config_path", "config_sha256", "external_commit", "normalizer_path",
    "normalizer_sha256", "prompt_manifest_path", "prompt_manifest_sha256",
    "schema_version", "serve_bundle_manifest_path", "serve_bundle_root",
    "serve_bundle_sha256", "serve_info_path", "serve_info_sha256",
    "serve_pool_root", "serve_task_id", "serve_tasks_path",
    "serve_tasks_sha256", "task_id", "train_meta_path", "train_meta_sha256"
  ],
  "properties": {
    "action_mode": {"const": "delta"},
    "base_repository": {"const": "NeoteAI/n0-twam-base"},
    "base_revision": {"const": "dafcb053902cc7a51310780fdfdb71ff8e79c0be"},
    "base_root": {"type": "string", "minLength": 1},
    "bundle_root": {"type": "string", "minLength": 1},
    "checkpoint_path": {"type": "string", "minLength": 1},
    "checkpoint_repository": {"const": "NeoteAI/n0-twam-univtac-delta"},
    "checkpoint_revision": {"const": "7694e63707a8c9e69e1a1242c4ed74ee39b7bb51"},
    "checkpoint_root": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_path": {"type": "string", "minLength": 1},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_commit": {"const": "c43a2160dd31c449d92b28eab52c0e2f09e4738a"},
    "normalizer_path": {"type": "string", "minLength": 1},
    "normalizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_manifest_path": {"type": "string", "minLength": 1},
    "prompt_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": "robotactile-n0-official-artifact-v3"},
    "serve_bundle_manifest_path": {"type": "string", "minLength": 1},
    "serve_bundle_root": {"type": "string", "minLength": 1},
    "serve_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "serve_info_path": {"type": "string", "minLength": 1},
    "serve_info_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "serve_pool_root": {"type": "string", "minLength": 1},
    "serve_task_id": {"type": "string", "pattern": "^univtac_.+_rot6d_current$"},
    "serve_tasks_path": {"type": "string", "minLength": 1},
    "serve_tasks_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"enum": ["grasp_classify", "insert_HDMI", "insert_hole", "insert_tube", "lift_bottle", "lift_can", "pull_out_key", "put_bottle_in_shelf"]},
    "train_meta_path": {"type": "string", "minLength": 1},
    "train_meta_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
