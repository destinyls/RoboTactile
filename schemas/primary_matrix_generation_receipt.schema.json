{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/primary_matrix_generation_receipt.schema.json",
  "title": "RoboTactile Primary Matrix Generation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id", "matrix_manifest_sha256", "generation_contract_sha256",
    "pair_key", "task_id", "cell_count", "comparison_count",
    "fault_manifest_count", "rest_reference_artifact_root_sha256",
    "rest_reference_sha256", "tactile_config_sha256",
    "no_touch_config_sha256", "members", "evidence_level",
    "simulator_execution_claimed", "task_success_claimed", "semantic_version"
  ],
  "properties": {
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "pair_key": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": "string", "minLength": 1},
    "cell_count": {"const": 142},
    "comparison_count": {"const": 70},
    "fault_manifest_count": {"const": 140},
    "rest_reference_artifact_root_sha256": {"$ref": "#/$defs/sha256"},
    "rest_reference_sha256": {"$ref": "#/$defs/sha256"},
    "tactile_config_sha256": {"$ref": "#/$defs/sha256"},
    "no_touch_config_sha256": {"$ref": "#/$defs/sha256"},
    "members": {
      "type": "object",
      "minProperties": 145,
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "evidence_level": {"const": "request_generation_only_no_simulator_execution"},
    "simulator_execution_claimed": {"const": false},
    "task_success_claimed": {"const": false},
    "semantic_version": {"const": "1.0"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
