{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/destinyls/RoboTactile/schemas/univtac_pre_move_trajectory.schema.json",
  "title": "UniVTAC source-bound pre-move trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "action_spec",
    "initial_seed",
    "exogenous_seed",
    "pair_key",
    "dataset_sha256",
    "checkpoint_sha256",
    "config_sha256",
    "source_run_content_sha256",
    "reset_reference_sha256",
    "capture_reset_receipt_sha256",
    "capture_simulator_state_sha256",
    "capture_native_step",
    "capture_qpos8",
    "source_qpos8_max_abs_error",
    "upstream_commit",
    "task_source_sha256",
    "post_reset_hold_steps",
    "segments",
    "capture_mode",
    "schema",
    "semantic_version"
  ],
  "properties": {
    "task_id": {"const": "grasp_classify"},
    "action_spec": {"const": "qpos8_next_step"},
    "initial_seed": {"type": "integer", "minimum": 0},
    "exogenous_seed": {"type": "integer", "minimum": 0},
    "pair_key": {"$ref": "#/$defs/sha256"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "source_run_content_sha256": {"$ref": "#/$defs/sha256"},
    "reset_reference_sha256": {"$ref": "#/$defs/sha256"},
    "capture_reset_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "capture_simulator_state_sha256": {"$ref": "#/$defs/sha256"},
    "capture_native_step": {"type": "integer", "minimum": 0},
    "capture_qpos8": {"$ref": "#/$defs/qpos8"},
    "source_qpos8_max_abs_error": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.002
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_source_sha256": {"$ref": "#/$defs/sha256"},
    "post_reset_hold_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "segments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/gripperSegment"},
        {"$ref": "#/$defs/armSegment"},
        {"$ref": "#/$defs/gripperSegment"},
        {"$ref": "#/$defs/armSegment"}
      ],
      "items": false
    },
    "capture_mode": {
      "const": "reset_only_source_proximity_guided_trajectory_v3"
    },
    "schema": {"const": "univtac-pre-move-trajectory-v3"},
    "semantic_version": {"const": "3.0"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finiteNumber": {"type": "number"},
    "joint9": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/finiteNumber"}
    },
    "qpos8": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/finiteNumber"}
    },
    "row1": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/finiteNumber"}
    },
    "row7": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/finiteNumber"}
    },
    "segmentBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_fingerprint",
        "start_joint9",
        "position",
        "velocity"
      ],
      "properties": {
        "kind": {"enum": ["arm", "gripper"]},
        "request_fingerprint": {"$ref": "#/$defs/sha256"},
        "start_joint9": {"$ref": "#/$defs/joint9"},
        "position": {"type": "array", "minItems": 1},
        "velocity": {"type": "array", "minItems": 1}
      }
    },
    "gripperSegment": {
      "allOf": [
        {"$ref": "#/$defs/segmentBase"},
        {
          "properties": {
            "kind": {"const": "gripper"},
            "position": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row1"}},
            "velocity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row1"}}
          }
        }
      ]
    },
    "armSegment": {
      "allOf": [
        {"$ref": "#/$defs/segmentBase"},
        {
          "properties": {
            "kind": {"const": "arm"},
            "position": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row7"}},
            "velocity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row7"}}
          }
        }
      ]
    }
  }
}
