  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "prompt_id",
        "prompt",
        "module_name",
        "class_name",
        "success_predicate_id",
        "task_source_sha256",
        "action_horizon",
        "early_stop_capable",
        "predicate_note"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "prompt_id": {"type": "string", "pattern": "^robotactile\\..+\\.v1$"},
        "prompt": {"type": "string", "minLength": 1},
        "module_name": {"type": "string", "pattern": "^envs\\..+$"},
        "class_name": {"const": "Task"},
        "success_predicate_id": {"type": "string", "pattern": "^univtac-upstream-05bcd3ed\\..+\\.check_success\\.v1$"},
        "task_source_sha256": {"$ref": "#/$defs/sha256"},
        "action_horizon": {"type": "integer", "minimum": 1},
        "early_stop_capable": {"type": "boolean"},
        "predicate_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
