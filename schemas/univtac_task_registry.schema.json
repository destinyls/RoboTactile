      "required": ["on_threshold_mm", "off_threshold_mm"],
      "properties": {
        "on_threshold_mm": {"const": 0.8},
        "off_threshold_mm": {"const": 0.3}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
