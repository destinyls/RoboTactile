{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotactile.invalid/schemas/univtac_task_registry.schema.json",
  "title": "RoboTactile Frozen UniVTAC Task Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "semantic_version",
    "upstream_repository",
    "upstream_commit",
    "runtime",
    "aliases",
    "phase_tracker",
    "tasks"
  ],
  "properties": {
    "registry_id": {"const": "robotactile_univtac_tasks_v1"},
    "semantic_version": {"const": "1.0"},
    "upstream_repository": {"const": "https://github.com/destinyls/UniVTAC"},
    "upstream_commit": {"const": "05bcd3edb92237107efa40105292a24f1a9fd761"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_spec",
        "action_mode",
        "force",
        "sim_hz",
        "decimation",
        "physics_steps_per_action",
        "canonical_joint_names",
        "action_lower_bounds",
        "action_upper_bounds",
        "head_shape",
        "wrist_shape",
        "tactile_rgb_shape",
        "tactile_depth_shape"
      ],
      "properties": {
        "action_spec": {"const": "qpos8_next_step"},
        "action_mode": {"const": "qpos"},
        "force": {"const": true},
        "sim_hz": {"const": 120},
        "decimation": {"const": 1},
        "physics_steps_per_action": {"const": 1},
        "canonical_joint_names": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {"const": "panda_joint1"},
            {"const": "panda_joint2"},
            {"const": "panda_joint3"},
            {"const": "panda_joint4"},
            {"const": "panda_joint5"},
            {"const": "panda_joint6"},
            {"const": "panda_joint7"},
            {"const": "panda_finger_joint1"},
            {"const": "panda_finger_joint2"}
          ],
          "items": false
        },
        "action_lower_bounds": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {"const": -2.8973},
            {"const": -1.7628},
            {"const": -2.8973},
            {"const": -3.0718},
            {"const": -2.8973},
            {"const": -0.0175},
            {"const": -2.8973},
            {"const": 0.0}
          ],
          "items": false
        },
        "action_upper_bounds": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {"const": 2.8973},
            {"const": 1.7628},
            {"const": 2.8973},
            {"const": -0.0698},
            {"const": 2.8973},
            {"const": 3.7525},
            {"const": 2.8973},
            {"const": 0.039}
