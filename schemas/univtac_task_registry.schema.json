              "class_name": {"const": "Task"},
              "success_predicate_id": {"const": "univtac-upstream-05bcd3ed.insert_hole.check_success.v1"},
              "task_source_sha256": {"const": "8b199327e549f979076e03082b0a8883cc71de351c90c30901c6af6c432ce1cb"},
