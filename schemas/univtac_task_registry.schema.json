            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "insert_tube"},
              "prompt_id": {"const": "robotactile.insert_tube.v1"},
              "prompt": {"const": "Align the tube and insert it into the target opening."},
              "module_name": {"const": "envs.insert_tube"},
              "class_name": {"const": "Task"},
              "success_predicate_id": {"const": "univtac-upstream-05bcd3ed.insert_tube.check_success.v1"},
              "task_source_sha256": {"const": "dca64e9232f459a5e3019eb3ba92c2b31e8aca4d64182c97e291b6575f5f7353"},
              "action_horizon": {"const": 300},
              "early_stop_capable": {"const": true},
              "predicate_note": {"const": "Frozen upstream predicate with signed offsets in its planar check; characterized, not benchmark-corrected."}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "lift_bottle"},
              "prompt_id": {"const": "robotactile.lift_bottle.v1"},
              "prompt": {"const": "Grasp the bottle securely and lift it above the success height."},
              "module_name": {"const": "envs.lift_bottle"},
              "class_name": {"const": "Task"},
              "success_predicate_id": {"const": "univtac-upstream-05bcd3ed.lift_bottle.check_success.v1"},
              "task_source_sha256": {"const": "46b9a691ec850004ffe2d226aa6e7e4ab84c7c2f1ab1548819f235b86f1e993c"},
              "action_horizon": {"const": 500},
              "early_stop_capable": {"const": true},
              "predicate_note": {"const": "Frozen upstream check_success behavior without benchmark-side correction."}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "lift_can"},
              "prompt_id": {"const": "robotactile.lift_can.v1"},
              "prompt": {"const": "Grasp the can securely and lift it above the success height."},
              "module_name": {"const": "envs.lift_can"},
              "class_name": {"const": "Task"},
              "success_predicate_id": {"const": "univtac-upstream-05bcd3ed.lift_can.check_success.v1"},
              "task_source_sha256": {"const": "2e6327443a895555675b1a5caab7e33d8f6dc99ef5b9328c0b7282b922aebffd"},
              "action_horizon": {"const": 300},
              "early_stop_capable": {"const": true},
              "predicate_note": {"const": "Frozen upstream check_success behavior without benchmark-side correction."}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "pull_out_key"},
              "prompt_id": {"const": "robotactile.pull_out_key.v1"},
              "prompt": {"const": "Grasp the key and pull it completely out of the lock."},
              "module_name": {"const": "envs.pull_out_key"},
              "class_name": {"const": "Task"},
              "success_predicate_id": {"const": "univtac-upstream-05bcd3ed.pull_out_key.check_success.v1"},
              "task_source_sha256": {"const": "d77e3a36df9a3c9aa4e445ac2f78f88f8a76d857d277801982a9b78bba8614be"},
              "action_horizon": {"const": 300},
              "early_stop_capable": {"const": true},
              "predicate_note": {"const": "Frozen upstream check_success behavior without benchmark-side correction."}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "put_bottle_in_shelf"},
