        },
        {
          "allOf": [
            {"$ref": "#/$defs/task"},
            {"properties": {
              "task_id": {"const": "insert_hole"},
              "prompt_id": {"const": "robotactile.insert_hole.v1"},
              "prompt": {"const": "Align the object with the hole and insert it to the target depth."},
