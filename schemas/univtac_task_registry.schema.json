        "wrist_shape": {"const": [270, 480, 3]},
        "tactile_rgb_shape": {"const": [240, 320, 3]},
        "tactile_depth_shape": {"const": [240, 320]}
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_camera",
        "wrist_camera",
        "left_tactile",
        "right_tactile",
        "left_physical_source_id",
        "right_physical_source_id",
        "sensor_type",
        "far_plane_mm",
        "calibration_id",
        "calibration_config_sha256",
        "tactile_payload"
      ],
      "properties": {
        "head_camera": {"const": "head"},
        "wrist_camera": {"const": "wrist"},
        "left_tactile": {"const": "left_tactile"},
        "right_tactile": {"const": "right_tactile"},
        "left_physical_source_id": {"const": "univtac-left-gsmini-sim-v1"},
        "right_physical_source_id": {"const": "univtac-right-gsmini-sim-v1"},
